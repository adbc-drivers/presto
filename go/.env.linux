# General driver validation uses PRESTO_DSN. The URI-specific tests in
# validation/tests/presto/test_uri.py build their own connection strings from
# the PRESTO_HOST/PRESTO_PORT/PRESTO_CATALOG/PRESTO_SCHEMA/PRESTO_SSL_* variables.

PRESTO_DSN="https://test@localhost:8443?catalog=memory&schema=default&SSLCertPath=${PWD}/ci/docker/certs/ca.crt"
PRESTO_HOST="localhost"
PRESTO_PORT="8443"
PRESTO_CATALOG="memory"
PRESTO_SCHEMA="default"
PRESTO_SSL_MODE="https"
PRESTO_SSL_CERT_PATH="${PWD}/ci/docker/certs/ca.crt"
PRESTO_USERNAME="test"
