# General driver validation uses PRESTO_DSN. The URI-specific tests in
# validation/tests/presto/test_uri.py build their own connection strings from
# the PRESTO_HOST/PRESTO_PORT/PRESTO_CATALOG/PRESTO_SCHEMA/PRESTO_SSL_* variables.

export PRESTO_DSN="presto://test@localhost:8443/memory/default?ssl_ca=${PWD}/ci/docker/certs/ca.crt"
export PRESTO_HOST="localhost"
export PRESTO_PORT="8443"
export PRESTO_HTTP_PORT="8080"
export PRESTO_HTTPS_PORT="8443"
export PRESTO_CATALOG="memory"
export PRESTO_SCHEMA="default"
export PRESTO_SSL_MODE="https"
export PRESTO_SSL_CERT_PATH="${PWD}/ci/docker/certs/ca.crt"
export PRESTO_USERNAME="test"
